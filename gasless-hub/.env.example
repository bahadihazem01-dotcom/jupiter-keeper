# ============================================================
# Solana Gasless Hub - Environment Configuration
# ============================================================

# --- Network Mode ---
# "devnet"  = FREE to use, unlimited SOL via airdrop (start here!)
# "mainnet" = real money, real transactions
SOLANA_NETWORK=devnet

# --- Helius RPC (recommended, free tier: 1M credits/month) ---
# Get your free API key at: https://dashboard.helius.dev
# Helius is an RPC provider (faster & more reliable than public Solana RPC)
# It is NOT a paymaster — it doesn't pay gas for you
HELIUS_API_KEY=

# --- Solana RPC (auto-set from SOLANA_NETWORK + HELIUS_API_KEY) ---
# Override manually if you have a different RPC provider
# Leave blank to auto-detect from network + Helius key
SOLANA_RPC_URL=

# --- Fee Payer Wallet ---
# The private key (base58) of the wallet that pays SOL gas fees.
# On devnet: auto-funded via airdrop (free!)
# On mainnet: needs a small SOL balance (~0.01 SOL = ~2000 transactions)
FEE_PAYER_PRIVATE_KEY=your_base58_private_key_here

# --- Kora Paymaster ---
# If connecting to an EXISTING Kora endpoint (plug-in mode):
KORA_ENDPOINT=http://localhost:8080

# --- Jito Block Engine ---
# For efficient transaction inclusion via Jito bundles (mainnet only)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR=  # Optional: Jito auth keypair for priority access

# --- Fee Configuration ---
# Margin pricing: users pay USDC, you keep the 10% margin
# The USDC token account (ATA) is auto-created by Kora on first tx
FEE_MARGIN=0.1

# Fee token mint (USDC) — users pay gas fees in this token
# Devnet USDC: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
FEE_TOKEN_MINT=

# --- Monitoring ---
# Port for the monitoring dashboard
MONITOR_PORT=3001

# --- Optional: Self-hosted Kora ---
# Set to true if you're running your own Kora node via Docker
SELF_HOSTED_KORA=false
KORA_PORT=8080
