# ============================================================
# Solana Gasless Hub - Environment Configuration
# ============================================================

# --- Solana RPC ---
# Your Solana RPC endpoint (use a paid RPC for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Fee Payer Wallet ---
# The private key (base58) of the wallet that pays SOL gas fees.
# This wallet needs a small SOL balance (~0.01 SOL = ~4000 transactions).
# You earn back more than you spend via the token fee margin.
FEE_PAYER_PRIVATE_KEY=your_base58_private_key_here

# --- Kora Paymaster ---
# If connecting to an EXISTING Kora endpoint (plug-in mode):
KORA_ENDPOINT=http://localhost:8080

# --- Jito Block Engine ---
# For efficient transaction inclusion via Jito bundles
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEYPAIR=  # Optional: Jito auth keypair for priority access

# --- Fee Configuration ---
# Margin on top of base gas cost (0.1 = 10% margin = your profit)
FEE_MARGIN=0.1

# Fee token mint (USDC by default)
FEE_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Monitoring ---
# Port for the monitoring dashboard
MONITOR_PORT=3001

# --- Optional: Self-hosted Kora ---
# Set to true if you're running your own Kora node via Docker
SELF_HOSTED_KORA=false
KORA_PORT=8080
