# Required
RPC_ENDPOINT=https://your-rpc-endpoint.com
PRIVATE_KEY=your-base58-encoded-private-key

# Optional - Balance & Profit
MIN_SOL_BALANCE=0.05
MIN_PROFIT_BPS=0

# Optional - Timing
POLL_INTERVAL_MS=5000
ORDER_DELAY_MS=1000

# Optional - Limits
MAX_ORDERS_PER_CYCLE=10

# Optional - Jupiter API
JUPITER_API_BASE_URL=https://quote-api.jup.ag/v6
SLIPPAGE_BPS=0

# Optional - Dashboard
DASHBOARD_PORT=3000
